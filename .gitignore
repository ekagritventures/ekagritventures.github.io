*.sublime-workspace

# Ruby/bundler files
.bundle/
vendor/
.ruby-version
.ruby-gemset
.bundle/config
.ruby-lsp/

# Jekyll development files
.jekyll-metadata
.sass-cache/
.jekyll-cache/

# Node files (if using any JS tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (NEVER commit these)
.env
.env.local
.env.development
.env.test
.env.production

# API keys and secrets — specific patterns only.
# NOTE: do NOT use broad globs like *key*/*api*/*token* here — they would
# silently ignore legitimate content (e.g. a post named "api-economy.md").
*.pem
*.key
*.p12
id_rsa
id_rsa.pub
secrets.yml
secrets.yaml
.secrets
credentials.json
serviceAccount*.json
